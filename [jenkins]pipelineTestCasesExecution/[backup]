                    mkdir -p $WORKSPACE/testresults $WORKSPACE/logfiles
                    export bamboo_CMAKE_BUILD_PARALLEL_LEVEL=1
                    . $WORKSPACE/bamboo/Squish/squishTestDefinitions.sh
                    squishTestsDir="$WORKSPACE/test/ui/squish/"
                    export SQUISH_AUTO_SCREENSHOT=3 
                    export SQUISH_SCRIPT_DIR="${WORKSPACE}/test/ui/squish/shared:${WORKSPACE}/test/ui/squish/../../scripts"
                    $SQUISH_PACKAGE/bin/squishserver --configfile $WORKSPACE/$ELISA_IP.config --verbose --port $SQUISHSERVER_PORT --daemon
                '''
            }
        }
        stage('Confirm the test case') {
                steps {
                    script {
                        if (params.MANOEUVRE_OR_WEANING == 'MANOEUVRE') {
                            // Change to a test case directory to find the configuration file
                            dir('test/ui/squish/EPC/tst_Validation_Manoeuvre_6') {
                                script{
                                    readConfigFile = readFile(file: 'config.ini')
                                }
                            }
                            echo 'Executing manoeuvre tests'
                            // Read the contents of the config file
                            sh "ls -l"  
                        } else if (params.MANOEUVRE_OR_WEANING == 'WEANING') {
                            // Change to a test case directory to find the configuration file
                            dir('test/ui/squish/EPC/tst_Validation_Weaning_6') {
                                script{
                                    readConfigFile = readFile(file: 'config.ini')
                                }
                            }
                            echo 'Executing weaning tests'
                            // Read the contents of the config file
                            sh "ls -l"  
                        }
                    }
                }
        }
        stage('Confirm the choice') {
                steps {
                    script {
                        if (params.OPTIONS == 'SINGULAR FEATURE') {
                            echo 'Executing a specific test'
                        } else if (params.OPTIONS == 'PARTIAL SECTION') {
                            echo 'Executing partially section tests'
                        } else if (params.OPTIONS == 'COMPREHENSIVE TESTCASE') {
                            echo 'Executing comprehensive test case'
                        }
                    }
                }
        }
        stage('Execute a singular feature') {
            when {
                expression { params.OPTIONS == 'SINGULAR FEATURE' }
            }
            steps {
                    script {
                        if (MANOEUVRE_OR_WEANING == 'WEANING') {
                            if (readConfigFile.contains('[weaning_adults]')) {
                                def matcher = readConfigFile =~ /(?<=\=)\s+(.*?\.feature)/
                                featureFiles = matcher.collect { match -> match[1] }
                            }
                            if (TEST_CASE in testCaseList) {
                                // find all features matching with suffix 
                            if (SECTION_NAME == 'weaning_adults') {
                                if (DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    result = featureFiles.findAll { it.endsWith("_Adults.feature") }
                                    if (result.contains(FEATURE_NAME)) {
                                        argumentOptionScriptArgs = FEATURE_NAME
                                        executeFeatureFile(argumentOptionScriptArgs,triggerSetUpFile)
                                        // custom displayName of the current build 
                                        currentBuild.displayName = "#${buildNumber}: ${argumentOptionScriptArgs}"
                                        return  
                                    } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The feature '$FEATURE_NAME' is not available in the feature files")
                                        }
                                    }
                                } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                                }
                            } else if (SECTION_NAME == 'weaning_children') {
                                if (DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    result = featureFiles.findAll { it.endsWith("_Children.feature") }
                                    if (result.contains(FEATURE_NAME)) {
                                        argumentOptionScriptArgs = FEATURE_NAME
                                        executeFeatureFile(argumentOptionScriptArgs,triggerSetUpFile)
                                        // custom displayName of the current build 
                                        currentBuild.displayName = "#${buildNumber}: ${argumentOptionScriptArgs}"
                                        return
                                    } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The feature '$FEATURE_NAME' is not available in the feature files")
                                        }
                                    }
                                } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                                }
                            } else if (SECTION_NAME == 'weaning_neonates') {
                                if (DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    // execute tests on Elisa600 and Elisa800
                                    result = featureFiles.findAll { it.endsWith("_Neonates.feature") }
                                    if (result.contains(FEATURE_NAME)) {
                                        argumentOptionScriptArgs = FEATURE_NAME
                                        executeFeatureFile(argumentOptionScriptArgs,triggerSetUpFile)
                                        // custom displayName of the current build 
                                        currentBuild.displayName = "#${buildNumber}: ${argumentOptionScriptArgs}"
                                        return
                                    } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The feature '$FEATURE_NAME' is not available in the feature files")
                                        }
                                    }
                                } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                                }
                            } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("Unable to find any section in the configuration")
                                    }
                                }
                            } else {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    error("Unable to find any test case in the configuration")
                                }
                            }
                        } else if (MANOEUVRE_OR_WEANING == 'MANOEUVRE') {
                            if (readConfigFile.contains('[manoeuvre_adults]')) {
                                def matcher = readConfigFile =~ /(?<=\=)\s+(.*?\.feature)/
                                featureFiles = matcher.collect { match -> match[1] }
                            }
                            if (TEST_CASE in testCaseList) {
                                // find all features matching with suffix 
                            if (SECTION_NAME == 'manoeuvre_adults') {
                                if (DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    result = featureFiles.findAll { it.endsWith("_Adults.feature") }
                                    if (result.contains(FEATURE_NAME)) {
                                        argumentOptionScriptArgs = FEATURE_NAME
                                        executeFeatureFile(argumentOptionScriptArgs,triggerSetUpFile)
                                        // custom displayName of the current build 
                                        currentBuild.displayName = "#${buildNumber}: ${argumentOptionScriptArgs}"
                                        return
                                    } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The feature '$FEATURE_NAME' is not available in the feature files")
                                        }
                                    }
                                } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                                }                               
                            } else if (SECTION_NAME == 'manoeuvre_children') {
                                if (DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    result = featureFiles.findAll { it.endsWith("_Children.feature") }
                                    if (result.contains(FEATURE_NAME)) {
                                        argumentOptionScriptArgs = FEATURE_NAME
                                        executeFeatureFile(argumentOptionScriptArgs,triggerSetUpFile)
                                        // custom displayName of the current build 
                                        currentBuild.displayName = "#${buildNumber}: ${argumentOptionScriptArgs}"
                                        return
                                    } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The feature '$FEATURE_NAME' is not available in the feature files")
                                        }
                                    }
                                } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                                }
                            } else if (SECTION_NAME == 'manoeuvre_neonates') {
                                if (DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    result = featureFiles.findAll { it.endsWith("_Neonates.feature") }
                                    if (result.contains(FEATURE_NAME)) {
                                        argumentOptionScriptArgs = FEATURE_NAME
                                        executeFeatureFile(argumentOptionScriptArgs,triggerSetUpFile)
                                        // custom displayName of the current build 
                                        currentBuild.displayName = "#${buildNumber}: ${argumentOptionScriptArgs}"
                                        return
                                    } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The feature '$FEATURE_NAME' is not available in the feature files")
                                        }
                                    }
                                } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                                }
                            } else if (!(SECTION_NAME in sectionsList)) {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("Unable to find any section in the configuration")
                                    }
                                }
                            } else {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    error("Unable to find any test case in the configuration")
                                }
                            }
                        }
                        if (!(TEST_CASE in testCaseList)) {
                            currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Testcase not exist"
                            return
                        } else if (!(SECTION_NAME in sectionsList)) {
                            currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Section not exist"   
                            return
                        } else if (!(DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800')) {
                            currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Device not exist"   
                            return
                        } else if (!(FEATURE_NAME in featureFiles)) {
                            currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Feature not exist"
                            return
                        }
                    }
                    echo "The feature file name for section '$SECTION_NAME' is: $result"
            }
        }
        stage('Execute partially section tests') {
            when {
                expression { params.OPTIONS == 'PARTIAL SECTION' }
            }
            steps {
                script {
                    if (MANOEUVRE_OR_WEANING == 'WEANING') {
                        if (TEST_CASE in testCaseList) { 
                            if (SECTION_NAME == 'weaning_adults') {
                                if (DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    def runGroupFeature = triggerGroupFeature[0]
                                    executeGroupFeatureInSection(SECTION_NAME,runGroupFeature)
                                    // custom displayName of the current build 
                                    currentBuild.displayName = "#${buildNumber}: Group of features ${SECTION_NAME}"  
                                    return
                                } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The '$DEVICE_TYPE' is not supported for this section")
                                        }
                                }
                            } else if (SECTION_NAME == 'weaning_children') {
                                if (DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    def runGroupFeature = triggerGroupFeature[1]
                                    executeGroupFeatureInSection(SECTION_NAME,runGroupFeature)
                                    // custom displayName of the current build 
                                    currentBuild.displayName = "#${buildNumber}: Group of features ${SECTION_NAME}"  
                                    return
                                } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The '$DEVICE_TYPE' is not supported for this section")
                                        }
                                }
                            } else if (SECTION_NAME == 'weaning_neonates') {
                                if (DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                    def runGroupFeature = triggerGroupFeature[2]
                                    executeGroupFeatureInSection(SECTION_NAME,runGroupFeature)
                                    // custom displayName of the current build 
                                    currentBuild.displayName = "#${buildNumber}: Group of features ${SECTION_NAME}"  
                                    return
                                } else {
                                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                            error("The '$DEVICE_TYPE' is not supported for this section")
                                        }
                                }
                            } else {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    error("Unable to find any section in the configuration")
                                }
                            }
                        } else {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    error("Unable to find any test case in the configuration")
                                }
                        }
                    } else if (MANOEUVRE_OR_WEANING == 'MANOEUVRE') {
                        if (TEST_CASE in testCaseList) { 
                            if (SECTION_NAME == 'manoeuvre_adults') {
                            if (DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                def runGroupFeature = triggerGroupFeature[3]
                                executeGroupFeatureInSection(SECTION_NAME,runGroupFeature)
                                // custom displayName of the current build 
                                currentBuild.displayName = "#${buildNumber}: Group of features ${SECTION_NAME}"  
                                return
                            } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                            }
                        } else if (SECTION_NAME == 'manoeuvre_children') {
                            if (DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                def runGroupFeature = triggerGroupFeature[4]
                                executeGroupFeatureInSection(SECTION_NAME,runGroupFeature)
                                // custom displayName of the current build 
                                currentBuild.displayName = "#${buildNumber}: Group of features ${SECTION_NAME}"  
                                return
                            } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                            }
                        } else if (SECTION_NAME == 'manoeuvre_neonates') {
                            if (DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800') {
                                def runGroupFeature = triggerGroupFeature[5]
                                executeGroupFeatureInSection(SECTION_NAME,runGroupFeature)
                                // custom displayName of the current build 
                                currentBuild.displayName = "#${buildNumber}: Group of features ${SECTION_NAME}"  
                                return
                            } else {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        error("The '$DEVICE_TYPE' is not supported for this section")
                                    }
                            }
                        } else {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    error("Unable to find any section in the configuration")
                                }
                            }
                        } else {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    error("Unable to find any test case in the configuration")
                                }
                        }
                    }
                    if (!(TEST_CASE in testCaseList)) {
                        currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Testcase not exist"
                        return
                    } else if (!(SECTION_NAME in sectionsList)) {
                        currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Section not exist"   
                        return
                    } else if (!(DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800')) {
                        currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Device not exist"   
                        return
                    } else if (!(FEATURE_NAME in featureFiles)) {
                        currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Feature not exist"
                        return
                    }
                    currentBuild.displayName = "#${buildNumber}: ${argumentOptionScriptArgs}"
                }
            }
        }
        stage('Execute comprehensive test case') {
            when {
                expression { params.OPTIONS == 'COMPREHENSIVE TESTCASE' }
            }
            steps {
                script {
                    if (MANOEUVRE_OR_WEANING == 'WEANING') {
                        if (readConfigFile.contains('[weaning_adults]')) {
                            def matcher = readConfigFile =~ /(?<=\=)\s+(.*?\.feature)/
                            featureFiles = matcher.collect { match -> match[1] }
                        }
                        //
                        if (TEST_CASE in testCaseList) {
                        
                        } else {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    error("Unable to find any test case in the configuration")
                                }
                        }
                    } else if (MANOEUVRE_OR_WEANING == 'MANOEUVRE') {
                        if (readConfigFile.contains('[manoeuvre_adults]')) {
                            def matcher = readConfigFile =~ /(?<=\=)\s+(.*?\.feature)/
                            featureFiles = matcher.collect { match -> match[1] }
                        }
                        //
                        if (TEST_CASE in testCaseList) {
                        
                        } else {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    error("Unable to find any test case in the configuration")
                                }
                        }
                    }
                    if (!(TEST_CASE in testCaseList)) {
                        currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Testcase not exist"
                        return
                    } else if (!(DEVICE_TYPE == 'Elisa300' || DEVICE_TYPE == 'Elisa500' || DEVICE_TYPE == 'Elisa600' || DEVICE_TYPE == 'Elisa800')) {
                        currentBuild.displayName = "#${buildNumber}: [${MANOEUVRE_OR_WEANING}] Device not exist"   
                        return
                    }
                    currentBuild.displayName = "#${buildNumber}: ${TEST_CASE} comprehensive executed"                    
                }
            }
        }
        stage('EndSquishrunner') {
            steps {
                sh '''tar -czf $WORKSPACE/logfiles/testresults.tgz $WORKSPACE/testresults
                $SQUISH_PACKAGE/bin/squishserver --port $SQUISHSERVER_PORT --stop'''
                }
        }
        stage('Archive') {
                steps {
                archiveArtifacts artifacts: 'logfiles/*.tgz', followSymlinks: false
                }
        }
        stage('Clean') {
                steps {
                cleanWs()
                }
        }
    }
}
