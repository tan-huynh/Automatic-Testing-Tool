def readConfigFile
def result
def final VERSION = '7.1.0'
def squishVersion = "/opt/squish/squish-for-qt-desktop_${VERSION}"
def concatenateName
def buildNumber = currentBuild.number
def featureFiles = []
def triggerSetUpFile = params.RUN_SETUP ? "setUpIncluded" : "setUpExcluded"
def argumentOptionScriptArgs = params.argumentOptionScriptArgs ?: "runWeaningAdults"
def sectionsList = ['weaning_adults', 'weaning_children', 'weaning_neonates', 'manoeuvre_adults', 'manoeuvre_children', 'manoeuvre_neonates']
def testCaseList = ['tst_Validation_Weaning_6', 'tst_Validation_Manoeuvre_6']
def triggerGroupFeature = ['runWeaningAdults', 'runWeaningChildren', 'runWeaningNeonates', 'runManoeuvreAdults', 'runManoeuvreChildren', 'runManoeuvreNeonates']
//TODO: Tester has two options to execute test case in Jenkins
//      1. Completely test case executed
//      2. If any test is failed, it is suitable by the second option given to execute again the failed feature.
def executeFeatureFile(argumentOptionScriptArgs, triggerSetUpFile) {
    stage("Execute '$argumentOptionScriptArgs'") {
        echo "Rerun feature '$argumentOptionScriptArgs'"
        concatenateName = "\\n--scriptargs\\n${argumentOptionScriptArgs}:${triggerSetUpFile}"
        concatenateName = concatenateName.replaceAll('\\\\n', '\n')
        squish([extraOptions: concatenateName, host: '127.0.0.1', port: '$SQUISHSERVER_PORT', resultFolder: '$WORKSPACE/testresults', squishPackageName: '7.1.0', testCase: '$TEST_CASE', testSuite: '$WORKSPACE/test/ui/squish/EPC'])   
    }
}
def executeGroupFeatureInSection(SECTION_NAME, runGroupFeature) {
    stage("Execute partially section tests '$SECTION_NAME'") {
        echo "Run group of feature '$SECTION_NAME'"
        concatenateName = "\\n--scriptargs\\n${runGroupFeature}"
        concatenateName = concatenateName.replaceAll('\\\\n', '\n')
        squish([extraOptions: concatenateName, host: '127.0.0.1', port: '$SQUISHSERVER_PORT', resultFolder: '$WORKSPACE/testresults', squishPackageName: '7.1.0', testCase: '$TEST_CASE', testSuite: '$WORKSPACE/test/ui/squish/EPC'])
    }
}
def comprehensiveTestCase(TEST_CASE, List<String> runListGroupFeature) {
    stage("Execute comprehensive test case '$TEST_CASE'") {
        if (!(runListGroupFeature instanceof List)) {
            throw new IllegalArgumentException("Parameter 'runListGroupFeature' must be a list")
        }
        echo "Run total test case '$TEST_CASE'"
        for (feature in runListGroupFeature) {
            concatenateName = "\\n--scriptargs\\n${feature}"
            concatenateName = concatenateName.replaceAll('\\\\n', '\n')
            squish([extraOptions: concatenateName, host: '127.0.0.1', port: '$SQUISHSERVER_PORT', resultFolder: '$WORKSPACE/testresults', squishPackageName: '7.1.0', testCase: '$TEST_CASE', testSuite: '$WORKSPACE/test/ui/squish/EPC'])
        }
    }
}
pipeline {
    agent any
        parameters {
            choice(name: 'OPTIONS', choices: ['PARTIAL SECTION', 'SINGULAR FEATURE', 'COMPREHENSIVE TESTCASE'], description: 'Select how you want to execute the tests')
            choice(name: 'MANOEUVRE_OR_WEANING', choices: ['WEANING', 'MANOEUVRE'], description: 'Select test cases which you want to execute the tests')
            booleanParam(name: 'RUN_SETUP', defaultValue: false, description: 'Should the set up file be executed?')
            string(name: 'TEST_CASE', defaultValue: 'tst_Validation_Weaning_6', description: 'Name of the test case (tst_Validation_Weaning_6/tst_Validation_Manoeuvre_6)')
            string(name: 'SECTION_NAME', defaultValue: 'weaning_adults', description: 'Name of the section in the config file')
            string(name: 'FEATURE_NAME', defaultValue: '', description: 'Name of the feature to run in Squish')
            string(name: 'SQUISH_PACKAGE', defaultValue: "$squishVersion", description: 'Actual squish package')
    }
    stages {
        stage('Elisa2Repo') {
            steps {
checkout([$class: 'GitSCM', branches: [[name: '*/$SQUISH_BRANCH']], extensions: [[$class: 'CloneOption', noTags: false, reference: '/var/lib/jenkins/git_repo_references', shallow: false, timeout: 5]], userRemoteConfigs: [[credentialsId: 'testlabor', url: 'ssh://git@gitlab.inh.lmi-dev.de:2222/elisa/elisa2.git']]])
	}
        }
        stage('StartSquishRunner') {
            steps {
                sh '''
                    for dir in app build_tools common doc external HAL implementations sonargraph tools; do
                        rm -rf "$WORKSPACE/$dir"
                    done
                    echo "[General]" | tee $WORKSPACE/$ELISA_IP.config >/dev/null
                    echo "attachableAUT/EPCremote = zzz$ELISA_IP:8888zzz" | tee -a $WORKSPACE/$ELISA_IP.config >/dev/null
                    sed -i 's/zzz/"/g' $WORKSPACE/$ELISA_IP.config
                    cat $WORKSPACE/$ELISA_IP.config
